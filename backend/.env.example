# Local/example configuration. Copy to backend/.env and fill in the required values.
# Never commit backend/.env. The application refuses to start without valid secrets.

PROJECT_NAME="OPERAN API"
API_V1_STR=/api/v1

# REQUIRED. Minimum 32 characters; placeholder values are rejected.
# Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# REQUIRED. Base64 of exactly 32 random bytes (AES-256-GCM).
# Generate with:
#   python -c "import base64,os; print(base64.b64encode(os.urandom(32)).decode())"
# WARNING: changing CRYPTO_KEY makes previously encrypted data unreadable.
# Plan a re-encryption migration before rotating a key that is already in use.
CRYPTO_KEY=

# REQUIRED. Key for PII blind indexes (e-mail, CPF, RG, CNPJ). Minimum 32
# characters, random, stored outside the database and different from SECRET_KEY.
# Changing it invalidates existing indexes; run a re-index migration.
# Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
PII_INDEX_KEY=

ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

DATABASE_URL=postgresql+asyncpg://operan_user:operan_password@localhost:5432/operan_db

# Set to true only for short-lived local debugging; SQL parameters may appear in logs.
SQL_ECHO=false

# Login throttling. Redis is optional; without REDIS_URL the limiter uses a
# process-local store (single-instance only). Set LOGIN_RATE_LIMIT_FAIL_OPEN=false
# to reject logins when Redis is unavailable.
REDIS_URL=
LOGIN_RATE_LIMIT_IP_ATTEMPTS=20
LOGIN_RATE_LIMIT_ACCOUNT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
LOGIN_RATE_LIMIT_BASE_BLOCK_SECONDS=60
LOGIN_RATE_LIMIT_MAX_BLOCK_SECONDS=900
LOGIN_RATE_LIMIT_STRIKES_TTL_SECONDS=3600
LOGIN_RATE_LIMIT_FAIL_OPEN=true
# Enable only when the app is behind a trusted reverse proxy.
TRUST_PROXY_HEADERS=false

BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
